apiVersion: v1
kind: Service
metadata:
  name: ${GOFLOW_NAME}
  namespace: ${NAMESPACE}
  labels:
    app: ${APP_LABEL}
    ipfix.cluster: ${CLUSTER_ID}
  annotations:
    metallb.io/address-pool: nok-lb-pool
spec:
  type: LoadBalancer
  loadBalancerIP: ${LOAD_BALANCER_IP}
  externalTrafficPolicy: Local
  internalTrafficPolicy: Cluster
  selector:
    app: ${APP_LABEL}
  ports:
    - name: ipfix
      port: 4739
      targetPort: 4739
      protocol: UDP
